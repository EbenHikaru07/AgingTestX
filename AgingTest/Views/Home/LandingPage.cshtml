    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "IoT Aging Test Monitoring System";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
}

@section Styles {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: white;
            padding: 140px 0 120px 0;
            margin-top: 56px;
        }

        .feature-card {
            transition: 0.3s ease-in-out;
            border-radius: 15px;
        }

            .feature-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            }

        .section-padding {
            padding: 90px 0;
        }

        .architecture-box {
            background: #f8fafc;
            border-radius: 15px;
            padding: 40px;
        }

        .hero-section {
            position: relative;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: white;
            padding: 140px 0 120px 0;
            margin-top: 56px;
            overflow: hidden;
        }

        .hero-bg-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 1200px;
            width: 80%;
            opacity: 0;
            z-index: 1;
            animation: fadeInBg 1.5s ease forwards;
        }

        @@keyframes fadeInBg {
            from

        {
            opacity: 0;
            transform: translate(-50%, -45%);
        }

        to {
            opacity: 0.15;
            transform: translate(-50%, -50%);
        }

        }

        .hero-section .container {
            position: relative;
            z-index: 3;
        }

    </style>
}

<section class="hero-section text-center">
    <img src="~/images/EXL-Logo_Flash-Black-RGB.png" class="hero-bg-image" alt="IoT Background" />

    <div class="container">
        <h1 class="display-4 fw-bold">
            Aging X
        </h1>
        <p class="lead mt-3">
            Real-Time Monitoring System for Lamp Aging Test Process
        </p>

        <div class="mt-4">
            <a href="#features" class="btn btn-outline-light btn-lg">
                Explore Features
            </a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-light btn-lg me-3">
                Get Started ➜
            </a>
        </div>
    </div>
</section>

<section id="about" class="section-padding text-center">
    <div class="container">
        <h2 class="fw-bold mb-4">Apa Itu Aging Test Monitoring?</h2>
        <p class="mt-4 fs-5">
            Platform monitoring berbasis Internet of Things (IoT) yang dirancang untuk mendukung proses aging test lampu produksi melalui pemantauan arus listrik secara real-time, pencatatan data historis, dan visualisasi informasi yang terintegrasi.
        </p>
    </div>
</section>

<section id="features" class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Fitur Sistem</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card feature-card p-4 text-center h-100 shadow-sm">
                    <h5 class="fw-bold">Real-Time Monitoring</h5>
                    <p class="text-muted">
                        Menampilkan data arus listrik hasil pengujian secara langsung sehingga kondisi operasional lampu dapat dipantau secara real-time selama proses aging berlangsung.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center h-100 shadow-sm">
                    <h5 class="fw-bold">Data Logging</h5>
                    <p class="text-muted">
                        Menyimpan dan mengelola data hasil pengujian secara terpusat untuk mendukung proses analisis, pelacakan histori, dan evaluasi performa pengujian.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center h-100 shadow-sm">
                    <h5 class="fw-bold">IoT Connectivity</h5>
                    <p class="text-muted">
                        Terhubung dengan perangkat IoT berbasis mikrokontroller yang melakukan akuisisi data dan mengirimkan informasi monitoring ke server secara otomatis melalui jaringan internet.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
