@model IEnumerable<AgingTest.Models.UserModel>

@{
    ViewData["Title"] = "User List";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container mt-4">

    <h3 class="mb-4">Data Users</h3>

    <table class="table table-bordered table-striped table-dark">
        <thead>
            <tr>
                <th>ID</th>
                <th>Badge</th>
                <th>Nama</th>
                <th>Role</th>
                <th>Status</th>
                <th>Last Active</th>
                <th>Created At</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.id_user</td>
                    <td>@user.user_badge</td>
                    <td>@user.username</td>
                    <td>@user.user_role</td>
                    <td>
                        @(user.user_status ? "Active" : "Inactive")
                    </td>
                    <td>
                        @(user.last_active?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                    </td>
                    <td>@user.created_at.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@user.remarks</td>
                </tr>
            }
        </tbody>
    </table>

</div>