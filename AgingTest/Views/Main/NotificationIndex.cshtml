    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<AgingTest.Models.NotificationModel>

@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container">

    <div class="card border-2 shadow-sm rounded-0">
        <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1">Notification Center</h4>
                <small class="text-muted">@Model.Count Notification</small>
            </div>
            <form asp-action="NotificationMarkAllAsRead" method="post">
                <button class="btn btn-primary rounded-3">
                    <i class="fas fa-check-double me-2"></i>Mark All Read
                </button>
            </form>
        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="notif-item p-4 border-bottom @(item.is_read ? "" : "bg-light")"
                         style="cursor:pointer"
                         data-id="@item.id_notif"
                         data-title="@item.title"
                         data-message="@item.message"
                         data-date="@item.created_at.ToString("dd MMM yyyy HH:mm:ss")"
                         data-read="@item.is_read.ToString().ToLower()">

                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="mb-1 fw-semibold">@item.title</h5>
                                    @if (!item.is_read)
                                    {
                                        <span class="badge bg-danger rounded-pill">New</span>
                                    }
                            </div>

                            <div class="text-muted small mt-2">
                                @(item.message.Length > 120
                                                            ? item.message.Substring(0, 120) + "..."
                                                            : item.message)
                        </div>
                                <div class="small text-secondary mt-3">
                                    <i class="fas fa-clock me-1"></i>
                                    @item.created_at.ToString("dd MMM yyyy HH:mm:ss")
                                </div>

                            </div>
                            <div>
                        @if (item.is_read)
                                {
                                    <span class="badge bg-success">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Unread</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-bell-slash fa-3x mb-3"></i>
                    <h5>Tidak ada notifikasi</h5>
                </div>
            }

        </div>

    </div>

</div>

<div class="modal fade" id="notifModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header border-0 pb-0">
                <div>
                    <div class="mb-2">
                        <span class="badge bg-primary">Notification</span>
                    </div>
                    <h4 id="notifTitle" class="fw-bold mb-1"></h4>
                    <small id="notifDate" class="text-muted"></small>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-3">

                <div class="p-4 rounded-4 bg-light">
                    <div id="notifMessage" class="fs-6 text-dark"></div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        const notifModal=new bootstrap.Modal(document.getElementById('notifModal'));

        document.querySelectorAll('.notif-item').forEach(item=>{

            item.addEventListener('click',async function(){

                let id=this.dataset.id;

                document.getElementById('notifTitle').innerText=this.dataset.title;
                document.getElementById('notifMessage').innerText=this.dataset.message;
                document.getElementById('notifDate').innerText=this.dataset.date;

                notifModal.show();

                if(this.dataset.read==="false"){

                    await fetch('/Main/NotificationMarkAsRead/'+id,{
                        method:'POST'
                    });

                    this.classList.remove('bg-light');

                    let badge=this.querySelector('.bg-danger');
                    if(badge) badge.remove();

                    let unread=this.querySelector('.bg-warning');
                    if(unread){
                        unread.classList.remove('bg-warning','text-dark');
                        unread.classList.add('bg-success');
                        unread.innerText='Read';
                    }

                }

            });

        });

    </script>

}

