@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model AgingTest.Models.AgingSetupViewModel

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Setup Aging Test";
}
<style>
    .progress {
        height: 14px;
        border-radius: 20px;
        background: #edf2f7;
    }

    .progress-bar {
        border-radius: 20px;
        transition: all .4s ease;
        background: linear-gradient( 90deg, #00c6ff, #0072ff );
    }

    .card {
        border: none;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

        .card:hover {
            box-shadow: 0 10px 28px rgba(0,0,0,0.08);
        }

    .bg-success {
        box-shadow: 0 0 10px rgba(25,135,84,.4);
    }

    .bg-warning {
        box-shadow: 0 0 10px rgba(255,193,7,.4);
    }

    .bg-danger {
        box-shadow: 0 0 12px rgba(220,53,69,.5);
    }
</style>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                Set Up Aging Test
            </h2>

            <small class="text-muted">
                Configure test parameters, monitoring thresholds and execution schedule
            </small>
        </div>
        <div class="text-end">
            <div class="badge bg-success px-3 py-2 fs-6">
                <strong>@Model.NamaDevice</strong> || <strong>@Model.DeviceCode</strong>
            </div>
        </div>
    </div>
<div id="alertBox" class="alert alert-danger" style="display:none;">
    <!-- Pesan validasi akan ditampilkan di sini -->
</div>
<form asp-action="StartAging" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DeviceId" />

    <div class="row g-3">
        <input type="hidden" id="modeInput" name="Mode" value="duration" />
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                    <h5 class="fw-semibold mb-3">Information</h5>
                    <hr />
                <div class="mb-3">
                    <label asp-for="LampuId" class="form-label fw-semibold">
                        Pilih Test Unit
                    </label>
                        @if (!Model.LampuList.Any())
                        {
                            <div class="alert alert-warning">
                                Semua lampu sedang digunakan.
                            </div>
                        }
                    <select asp-for="LampuId"
                            class="form-select rounded-3"
                            asp-items="Model.LampuList">
                        <option value="" selected disabled>-- Pilih Lampu --</option>
                    </select>
                </div>

                <div id="lampuDetail" class="mt-3 p-3 border rounded-3 bg-light" style="display:none;">
                    <h6 class="fw-semibold mb-2">Detail Lampu</h6>

                    <div class="small">
                        <div>Kode: <strong id="kodeLampu"></strong></div>
                        <div>Tipe: <strong id="tipeLampu"></strong></div>
                        <div>Arus Nominal: <strong id="arusLampu"></strong> A</div>
                        <div>Tegangan Nominal: <strong id="teganganLampu"></strong> V</div>
                    </div>
                </div>
                
            </div>
        </div>
        <div class="col-lg-4">
                <div id="powerIndicator" class="mt-3 d-none">

                    <h6 class="fw-semibold mb-2">⚡ Power Usage Indicator</h6>
                    <div id="powerStatus" class="mt-2 fw-semibold text-center"></div>
                    <!-- CURRENT -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small"><span>Arus (A)</span><span id="currentText"></span></div>
                        <div class="progress">
                            <div id="currentBar" class="progress-bar"></div>
                        </div>
                    </div>

                    <!-- VOLTAGE -->
                    <div>
                        <div class="d-flex justify-content-between small">
                            <span>Tegangan (V)</span>
                            <span id="voltageText"></span>
                        </div>
                        <div class="progress">
                            <div id="voltageBar" class="progress-bar"></div>
                        </div>
                    </div>
                </div>
                <div id="parameterForm">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="fw-semibold mb-3"> Form Parameter Uji</h5>
                        <hr />
                        <!-- ARUS -->
                        <div class="row mb-4">
                            <h6 class="fw-semibold">Current Value (A)</h6>
                            <hr />
                            <div class="col-4">

                                <label>Min (A)</label>
                                <input name="current_min"
                                       id="current_min"
                                       type="number"
                                       step="0.01"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                            <div class="col-4">
                                <label>Nominal (A)</label>
                                <input name="nominal_current"
                                       id="nominal_current"
                                       type="number"
                                       step="0.01"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                            <div class="col-4">
                                <label>Max (A)</label>
                                <input name="current_max"
                                       id="current_max"
                                       type="number"
                                       step="0.01"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                        </div>

                        <h6 class="fw-semibold">Voltage Value (V)</h6>
                        <hr />
                        <!-- VOLTAGE -->
                        <div class="row mb-3">
                            <div class="col">
                                <label>Min (V)</label>
                                <input name="voltage_min"
                                       id="voltage_min"
                                       type="number"
                                       step="0.1"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                            <div class="col">
                                <label>Nominal (V)</label>
                                <input name="nominal_voltage"
                                       id="nominal_voltage"
                                       type="number"
                                       step="0.01"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                            <div class="col">
                                <label>Max (V)</label>
                                <input name="voltage_max"
                                       id="voltage_max"
                                       type="number"
                                       step="0.1"
                                       placeholder="..."
                                       class="form-control" style="border:1px solid gray;" />
                            </div>
                        </div>
                        <div class="row">
                           
                        </div>
                        <button type="button"
                                class="btn btn-primary w-100 mt-3"
                                onclick="saveParameter()">
                            💾 Simpan Parameter
                        </button>
                      
                    </div>
                </div>
        </div>
        <!-- 🟢 RIGHT: CONTROL -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">

                <h5 class="fw-semibold mb-3">Scheduling & Control</h5>

                <!-- 🔥 MODE SWITCH -->
                <div class="btn-group w-100 mb-4">
                    <button type="button"
                            id="modeDuration"
                            class="btn btn-outline-success active">
                        ⏱ Duration
                    </button>

                    <button type="button"
                            id="modeSchedule"
                            class="btn btn-outline-success">
                        📅 Schedule
                    </button>
                </div>

                <!-- 🔥 MODE 1: DURATION -->
                <div id="durationSection">

                    <label class="form-label">Lifetime (Jam)</label>

                    <div class="input-group">
                        <input type="number"
                               asp-for="LifetimeHours"
                               min="1"
                               class="form-control"
                               placeholder="Masukkan jam..." />

                        <span class="input-group-text">Jam</span>
                    </div>

                </div>

                <!-- 🔥 MODE 2: SCHEDULE -->
                <div id="scheduleSection" style="display:none;">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Start Time</label>
                            <input type="datetime-local"
                                   asp-for="StartTime"
                                   id="StartTime"
                                   class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Time</label>
                            <input type="datetime-local"
                                   name="EndTime"
                                   id="EndTime"
                                   class="form-control" />
                        </div>

                    </div>

                </div>

                <!-- 🔥 INFO -->
                <div class="mt-3">
                    <small class="text-muted">
                        Mode Duration → langsung jalan sesuai jam<br />
                        Mode Schedule → mengikuti waktu start & end
                    </small>
                </div>

                <!-- 🔥 BUTTON -->
                <div class="mt-4 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-success w-100 rounded-pill">
                        ▶ Start Aging
                    </button>

                    <a asp-action="Dashboard"
                       class="btn btn-secondary w-100 rounded-pill">
                        Cancel
                    </a>
                </div>
                    <div class="card mt-4 p-3 border-0 shadow-sm">

                        <h6 class="fw-bold mb-3">
                            📋 Test Summary
                        </h6>

                        <div id="summaryContent">

                            <small class="text-muted">
                                Belum ada lampu dipilih
                            </small>

                        </div>

                    </div>
            </div>
        </div>
    </div>
</form>
</div>

<script>

    const lampuData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LampuData));
    const deviceSpec = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DeviceSpec));

    const lampuSelect = document.getElementById("LampuId");
    const form = document.querySelector("form");
    const alertBox = document.getElementById("alertBox");

    const durationBtn = document.getElementById("modeDuration");
    const scheduleBtn = document.getElementById("modeSchedule");

    const durationSection = document.getElementById("durationSection");
    const scheduleSection = document.getElementById("scheduleSection");

    // ================= MODE =================
    durationBtn.onclick = () => setMode("duration");
    scheduleBtn.onclick = () => setMode("schedule");

    function setMode(mode) {
        const duration = mode === "duration";

        durationSection.style.display = duration ? "block" : "none";
        scheduleSection.style.display = duration ? "none" : "block";
        document.querySelector("[name='LifetimeHours']").disabled = !duration;
        document.getElementById("StartTime").disabled = duration;
        document.getElementById("EndTime").disabled = duration;
        document.getElementById("modeInput").value = mode;
        durationBtn.classList.toggle("active", duration);
        scheduleBtn.classList.toggle("active", !duration);

        updateSummary();
    }

    // ================= LAMPU =================

        lampuSelect.addEventListener("change", function () {
        updateSummary();

        const id = parseInt(this.value);

    if (!id) {

        resetAll();
        updateSummary();

        return;
    }
        const lampu = lampuData.find(x => x.id_lamp === id);

        if (lampu) {
            showLampu(lampu);
        }

        if (!lampu) {
            hideLampu();
            return;
        }

        fetch(`/Main/GetParameter?id=${id}`)
        .then(res => res.json())
        .then(param => {

            document.getElementById("parameterForm").style.display = "block";

            // BELUM ADA PARAMETER
                if (!param) {

        resetParameter();

        showNoParameter();

        updateIndicator({
            nominal_current:0,
            nominal_voltage:0
        });

        return;
    }
        function resetParameter() {

        setValue("nominal_current", "");
        setValue("current_min", "");
        setValue("current_max", "");

        setValue("nominal_voltage", "");
        setValue("voltage_min", "");
        setValue("voltage_max", "");
    }
            // LOAD PARAMETER
            setValue("nominal_current", param.nominal_current);
            setValue("current_min", param.current_min);
            setValue("current_max", param.current_max);

            setValue("nominal_voltage", param.nominal_voltage);
            setValue("voltage_min", param.voltage_min);
            setValue("voltage_max", param.voltage_max);

            // UPDATE OBJECT LAMPU
            lampu.parameter = {
                nominal_current: param.nominal_current,
                nominal_voltage: param.nominal_voltage,
                current_min: param.current_min,
                current_max: param.current_max,
                voltage_min: param.voltage_min,
                voltage_max: param.voltage_max
            };

            // REFRESH DETAIL
            showLampu(lampu);

            updateIndicator({
                nominal_current: param?.nominal_current ?? 0,
                nominal_voltage: param?.nominal_voltage ?? 0
            });

            updateSummary();
        });
    });

    document.getElementById("StartTime")?.addEventListener("change", updateSummary);
    document.getElementById("EndTime")?.addEventListener("change", updateSummary);
    document.querySelector("[name='LifetimeHours']")?.addEventListener("input", updateSummary);

    function showLampu(lampu) {

        document.getElementById("lampuDetail").style.display = "block";
        document.getElementById("powerIndicator").style.display = "block";
        document.getElementById("lampuDetail").innerHTML = `
            <h6 class="fw-semibold mb-2">Detail Lampu</h6>

            <div class="small">
                 <div>Kode: <strong>${lampu.lamp_code}</strong></div>
                 <div>Arus:<strong>${lampu.parameter?.nominal_current ?? '-'}</strong> A</div>
                 <div>Tegangan:<strong>${lampu.parameter?.nominal_voltage ?? '-'}</strong> V</div>
            </div>
        `;
    }

    function updateSummary() {

        const lampu =
            lampuSelect.options[
                lampuSelect.selectedIndex
            ]?.text || "-";

        const lifetime =
            document.querySelector(
                "[name='LifetimeHours']"
            )?.value || 0;

        const start = document.getElementById("StartTime")?.value;
        const end = document.getElementById("EndTime")?.value;
        const mode = document.getElementById("modeInput")?.value;

        let html = `
            <div class="mb-2">
                <strong>Lampu:</strong> ${lampu}
            </div>
        `;

        if (mode === "duration") {

            html += `
                <div class="mb-2">
                    <strong>Mode:</strong> Duration
                </div>
                <div>
                    <strong>Lifetime:</strong>
                    ${lifetime} Jam
                </div>
            `;
        }
        else {

            html += `
                <div class="mb-2">
                    <strong>Mode:</strong> Schedule
                </div>
                <div class="mb-2">
                    <strong>Start:</strong>
                    ${start || "-"}
                </div>
                <div>
                    <strong>End:</strong>
                    ${end || "-"}
                </div>
            `;
        }

        document.getElementById(
            "summaryContent"
        ).innerHTML = html;
    }

    function showNoParameter(id) {

        document.getElementById("lampuDetail").style.display = "block";
        document.getElementById("lampuDetail").innerHTML = `
        <h6 class="fw-semibold mb-2">
            Detail Lampu
        </h6>

        <div class="alert alert-warning mb-0">
            Parameter belum tersedia, silahkan isi parameter uji di form samping.
        </div>
    `;
        document.getElementById("parameterForm").style.display = "block";
        // reset field
        setValue("nominal_current", "");
        setValue("current_min", "");
        setValue("current_max", "");

        setValue("nominal_voltage", "");
        setValue("voltage_min", "");
        setValue("voltage_max", "");
    }

    function resetAll() {

        // reset detail lampu
        document.getElementById("lampuDetail").innerHTML = `
            <h6 class="fw-semibold mb-2">Detail Lampu</h6>

            <div class="small text-muted">
                Belum ada lampu dipilih
            </div>
        `;

        // reset progress bar
        updateIndicator({
            nominal_current:0,
            nominal_voltage:0
        });

        // reset parameter
        [
            "nominal_current",
            "current_min",
            "current_max",
            "nominal_voltage",
            "voltage_min",
            "voltage_max"
        ].forEach(id=>setValue(id,""));

    }

    // ================= TOLERANCE =================
    [
        "nominal_current",
        "current_tolerance",
        "nominal_voltage",
        "voltage_tolerance"
    ]
    .forEach(id => {
        document.getElementById(id)?.addEventListener("input", hitung);
    });

    function hitung() {

        calcTolerance(
            "nominal_current",
            "current_tolerance",
            "current_min",
            "current_max"
        );

        calcTolerance(
            "nominal_voltage",
            "voltage_tolerance",
            "voltage_min",
            "voltage_max"
        );
    }

    function calcTolerance(nominalId, tolId, minId, maxId) {

        const nominal =
            parseFloat(document.getElementById(nominalId).value);
        const tol =
            parseFloat(document.getElementById(tolId).value);
        if (isNaN(nominal) || isNaN(tol))
            return;
        const min = nominal - (nominal * tol / 100);
        const max = nominal + (nominal * tol / 100);
        setValue(minId, min.toFixed(2));
        setValue(maxId, max.toFixed(2));
    }

    // ================= POWER =================
    function updateIndicator(param) {
        updateBar(
            "currentBar",
            "currentText",
            param.nominal_current,
            deviceSpec.max_current
        );

        updateBar(
            "voltageBar",
            "voltageText",
            param.nominal_voltage,
            deviceSpec.max_voltage
        );
    }

    function updateBar(barId, textId, value, max) {
        value = Number(value ?? 0);
        max = Number(max ?? 1);

        const percent = (value / max) * 100;
        const safePercent = Math.min(percent, 100);
        const bar = document.getElementById(barId);
        const text = document.getElementById(textId);

        // width
        bar.style.width = safePercent + "%";

        // reset class
        bar.className = "progress-bar";
        text.classList.remove(
            "text-success",
            "text-warning",
            "text-danger"
        );

        // color
        if (percent > 100) {
            bar.classList.add("bg-danger");
            text.classList.add("text-danger");
        }
        else if (percent > 80) {
            bar.classList.add("bg-warning");
            text.classList.add("text-warning");
        }
        else {
            bar.classList.add("bg-success");
            text.classList.add("text-success");
        }
        // text
        text.innerText =
            `${value} / ${max}`;
    }

    // ================= VALIDATION =================
    form.addEventListener("submit", function (e) {

        let errors = [];

        if (!lampuSelect.value)
            errors.push("Lampu wajib dipilih.");
        if (durationSection.style.display === "block") {
            const jam = parseInt(document.querySelector("[name='LifetimeHours']").value);
            if (!jam || jam <= 0)
                errors.push("Lifetime tidak valid. Silahkan tentukan waktu berdasarkan jam.");
        }
        if (scheduleSection.style.display === "block") {

            const start = document.getElementById("StartTime").value;
            const end = document.getElementById("EndTime").value;

            if (!start || !end)
                errors.push("Schedule belum lengkap.");

                if (start && end) {
        if (new Date(start) >= new Date(end)) {
            errors.push("End time harus setelah tanggal start time.");
        }
    }
        }

        if (errors.length > 0) {
            e.preventDefault();
            alertBox.style.display = "block";
            alertBox.innerHTML = errors.join("<br>");
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }
    });

    function saveParameter() {
        const data = {
            id_lamp: parseInt(document.getElementById("LampuId").value),
            nominal_current: parseFloat(document.getElementById("nominal_current").value),
            nominal_voltage: parseFloat(document.getElementById("nominal_voltage").value),
            current_min: parseFloat(document.getElementById("current_min").value),
            current_max: parseFloat(document.getElementById("current_max").value),
            voltage_min: parseFloat(document.getElementById("voltage_min").value),
            voltage_max: parseFloat(document.getElementById("voltage_max").value)
        };

        // VALIDASI
        if (!data.id_lamp)
            return alert("Lampu belum dipilih!");

        if (!data.nominal_current || !data.nominal_voltage)
            return alert("Nominal harus diisi!");

        fetch("/Main/SaveParameterUji", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken":
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value
            },

            body: JSON.stringify(data)
        })
        .then(res => res.json())
            .then(res => {
        if (!res.success)
            throw new Error(res.message);
        alert(res.message);
        updateIndicator({
            nominal_current: data.nominal_current,
            nominal_voltage: data.nominal_voltage
        });
        updateSummary();
    })

        .catch(err => {
            alert(err.message);
        });
    }
    // ================= HELPER =================

    function setValue(id, value) {
        document.getElementById(id).value = value ?? '';
    }
    updateSummary();
</script>