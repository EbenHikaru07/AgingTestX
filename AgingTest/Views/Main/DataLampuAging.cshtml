@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<AgingTest.Models.DataLampu>
@using System.Text.Encodings.Web

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Data Lampu";
}

<div class="container-fluid">

    <!-- ALERT -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Master Data Lampu</h3>
            <small class="text-muted">Manajemen Tipe Lampu</small>
        </div>

        <button class="btn btn-primary shadow" data-bs-toggle="modal" data-bs-target="#createModal">
            + Tambah Lampu
        </button>
    </div>

    <!-- TABLE -->
    <div class="card shadow-lg border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>No</th>
                            <th>Nama</th>
                            <th>Kode</th>
                            <th>Tipe</th>
                            <th>Arus</th>
                            <th>Voltage</th>
                            <th>Parameter</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int no = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@no++</td>
                                <td>@item.lamp_name</td>
                                <td>@item.lamp_code</td>
                                @* <td>@(item.ParameterUji?.nominal_current ?? 0) A</td>
                                <td>@(item.ParameterUji?.nominal_voltage ?? 0) V</td> *@

                                <td>
                                    <button class="btn btn-sm btn-info"
                                            onclick="setParameter(@item.id_lamp)">
                                        Set
                                    </button>
                                </td>

                                <td>
                                    @if (item.lamp_status)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <button class="btn btn-sm btn-warning"
                                            onclick="editLampu(
                                                    @item.id_lamp,
                                                    '@Html.Raw(JavaScriptEncoder.Default.Encode(item.lamp_name))',
                                                    '@Html.Raw(JavaScriptEncoder.Default.Encode(item.lamp_code))',
                                                    @item.lamp_status.ToString().ToLower(),
                                                    '@Html.Raw(JavaScriptEncoder.Default.Encode(item.remarks ?? ""))')">
                                        Edit
                                    </button>

                                    <a asp-action="DeleteLampuAging"
                                       asp-route-id="@item.id_lamp"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Yakin hapus data?')">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade" id="createModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow border-0">

            <form asp-action="CreateLampuAging" method="post">

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Tambah Lampu</h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label>Nama Lampu</label>
                            <input name="nama_lampu" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label>Kode Lampu</label>
                            <input name="kode_lampu" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label>Status</label>
                            <select name="status_lampu" class="form-select">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label>Remarks</label>
                            <textarea name="remarks" class="form-control"></textarea>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary">Save</button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow border-0">

            <form asp-action="EditLampuAging" method="post">

                <input type="hidden" name="id_lampu" id="edit_id" />

                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">Edit Lampu</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label>Nama Lampu</label>
                            <input id="edit_nama" name="nama_lampu" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label>Kode Lampu</label>
                            <input id="edit_kode" name="kode_lampu" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label>Tipe</label>
                            <input id="edit_tipe" name="tipe_lampu" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label>Status</label>
                            <select id="edit_status" name="status_lampu" class="form-select">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label>Remarks</label>
                            <textarea id="edit_remarks" name="remarks" class="form-control"></textarea>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary">Update</button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- ================= PARAMETER MODAL ================= -->
<div class="modal fade" id="parameterModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-lg border-0">

            <form asp-action="SaveParameterUji" method="post">

                <input type="hidden" name="id_lampu" id="param_id_lampu" />

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">⚡ Set Parameter Lampu</h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-4">

                        <!-- ARUS -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm p-3">
                                <h6 class="fw-bold text-primary mb-3">ARUS</h6>

                                <div class="row">
                                    <div class="col-8">
                                        <label>Nominal (A)</label>
                                        <input id="param_arus_nominal" name="nominal_current"
                                               type="number" step="0.01"
                                               class="form-control mb-2" />
                                    </div>
                                    <div class="col-4">
                                        <label>Tolerance (%)</label>
                                        <input id="param_arus_tol" name="arus_tol"
                                               type="number" step="0.1"
                                               class="form-control mb-2"
                                               placeholder="%" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col">
                                        <label>Min</label>
                                        <input id="param_arus_min" name="current_min"
                                               class="form-control bg-light text-center" />
                                    </div>
                                    <div class="col">
                                        <label>Max</label>
                                        <input id="param_arus_max" name="current_max"
                                               class="form-control bg-light text-center" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TEGANGAN -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm p-3">
                                <h6 class="fw-bold text-warning mb-3">TEGANGAN</h6>

                                <div class="row">
                                    <div class="col-8">
                                        <label>Nominal (V)</label>
                                        <input id="param_tegangan_nominal" name="nominal_voltage"
                                               type="number" step="0.01"
                                               class="form-control mb-2" />
                                    </div>
                                    <div class="col-4">
                                        <label>Tolerance (%)</label>
                                        <input id="param_tegangan_tol" name="tegangan_tol"
                                               type="number" step="0.1"
                                               class="form-control mb-2"
                                               placeholder="%" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col">
                                        <label>Min</label>
                                        <input id="param_tegangan_min" name="voltage_min"
                                               class="form-control bg-light text-center" />
                                    </div>
                                    <div class="col">
                                        <label>Max</label>
                                        <input id="param_tegangan_max" name="voltage_max"
                                               class="form-control bg-light text-center" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-success px-4">💾 Save</button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        function hitungTolerance() {

            let arus = parseFloat(document.getElementById("param_arus_nominal").value);
            let arusTol = parseFloat(document.getElementById("param_arus_tol").value);

            let tegangan = parseFloat(document.getElementById("param_tegangan_nominal").value);
            let teganganTol = parseFloat(document.getElementById("param_tegangan_tol").value);

            // ===== ARUS =====
            if (!isNaN(arus) && !isNaN(arusTol)) {
                document.getElementById("param_arus_min").value = (arus - (arus * arusTol / 100)).toFixed(2);
                document.getElementById("param_arus_max").value = (arus + (arus * arusTol / 100)).toFixed(2);
            }

            // ===== TEGANGAN =====
            if (!isNaN(tegangan) && !isNaN(teganganTol)) {
                document.getElementById("param_tegangan_min").value = (tegangan - (tegangan * teganganTol / 100)).toFixed(2);
                document.getElementById("param_tegangan_max").value = (tegangan + (tegangan * teganganTol / 100)).toFixed(2);
            } else {
                document.getElementById("param_tegangan_min").value = '';
                document.getElementById("param_tegangan_max").value = '';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

            [
                "param_arus_nominal",
                "param_arus_tol",
                "param_tegangan_nominal",
                "param_tegangan_tol"
            ].forEach(id => {
                document.getElementById(id)?.addEventListener("input", hitungTolerance);
            });

        });

        function editLampu(id, nama, kode, tipe, status, remarks) {

            document.getElementById("edit_id").value = id;
            document.getElementById("edit_nama").value = nama;
            document.getElementById("edit_kode").value = kode;
            document.getElementById("edit_tipe").value = tipe;
            document.getElementById("edit_status").value = status;
            document.getElementById("edit_remarks").value = remarks;

            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        function setParameter(id) {

            document.getElementById("param_id_lampu").value = id;

            [
                "param_arus_nominal",
                "param_arus_min",
                "param_arus_max",
                "param_tegangan_nominal",
                "param_tegangan_min",
                "param_tegangan_max",
                "param_arus_tol",
                "param_tegangan_tol"
            ].forEach(x => document.getElementById(x).value = '');

            fetch('/Main/GetParameter?id=' + id)
                .then(res => res.json())
                .then(data => {

                    if (data) {
                        document.getElementById("param_arus_nominal").value = data.nominal_current ?? '';
                        document.getElementById("param_tegangan_nominal").value = data.nominal_voltage ?? '';
                        document.getElementById("param_arus_min").value = data.current_min ?? '';
                        document.getElementById("param_arus_max").value = data.current_max ?? '';
                        document.getElementById("param_tegangan_min").value = data.voltage_min ?? '';
                        document.getElementById("param_tegangan_max").value = data.voltage_max ?? '';
                        document.getElementById("param_arus_tol").value = data.arus_tol ?? '';
                        document.getElementById("param_tegangan_tol").value = data.tegangan_tol ?? '';
                    }

                    hitungTolerance();
                });

            new bootstrap.Modal(document.getElementById('parameterModal')).show();
        }

    </script>
}