    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold">Dashboard Overview</h3>
        <span class="text-muted small">
            Monitoring Panel - Aging Test System
        </span>
    </div>

    <div class="row g-4 mb-4">

        <!-- LEFT CARD - AGING TEST INFO -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 shadow-sm h-100">
                <h5 class="mb-3">Aging Test Information</h5>

                <div class="small text-muted mb-2">
                    Device Name : <strong>Power Supply X1</strong>
                </div>
                <div class="small text-muted mb-2">
                    Device ID : <strong>AGT-001</strong>
                </div>
                <div class="small text-muted mb-2">
                    Location : <strong>Production Line A</strong>
                </div>
                <div class="small text-muted mb-2">
                    Mode : <strong>Continuous</strong>
                </div>
            </div>
        </div>

        <!-- RIGHT CARD - SCHEDULING -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 shadow-sm h-100">
                <h5 class="mb-3">Scheduling & Control</h5>

                <!-- MODE TOGGLE -->
                <div class="btn-group w-100 mb-3" role="group">
                    <button type="button" id="modeDuration" class="btn btn-outline-success active">
                        Duration Mode
                    </button>
                    <button type="button" id="modeSchedule" class="btn btn-outline-success">
                        Schedule Mode
                    </button>
                </div>

                <!-- MODE 1 : DURATION -->
                <div id="durationSection">

                    <label class="form-label small">Test Duration</label>

                    <div class="input-group">
                        <input type="number"
                               min="0"
                               id="durationInput"
                               class="form-control"
                               placeholder="e.g 2">
                        <span class="input-group-text">Hours</span>
                    </div>

                </div>

                <!-- MODE 2 : SCHEDULE -->
                <div id="scheduleSection" style="display:none;">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label small">Start Time</label>
                            <input type="datetime-local" id="startTimeInput" class="form-control">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small">End Time</label>
                            <input type="datetime-local" id="endTimeInput" class="form-control">
                        </div>

                    </div>

                </div>

                <!-- STANDBY TOTAL -->
                <div class="mt-3">
                    <small class="text-muted">
                        Standby Total :
                        <strong id="standbyTotal">00:00:00</strong>
                    </small>
                </div>

                <!-- BUTTONS -->
                <div class="mt-3 d-flex gap-2">
                    <button id="startBtn" class="btn btn-success w-50">
                        ▶ START
                    </button>
                    <button id="stopBtn" class="btn btn-danger w-50" disabled>
                        ⛔ EMERGENCY STOPs
                    </button>
                </div>
            </div>
        </div>

    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card card-custom p-3 shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Voltage</small>
                        <h4 id="voltageValue" class="mt-2">220 V</h4>
                    </div>
                    <i class="bi bi-lightning-charge fs-2 text-warning"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Current</small>
                        <h4 id="currentValue" class="mt-2">1.25 A</h4>
                    </div>
                    <i class="bi bi-activity fs-2 text-info"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Lifetime</small>
                        <h4 id="lifetimeValue" class="mt-2">00:00:00</h4>
                    </div>
                    <i class="bi bi-clock-history fs-2 text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-custom p-3 shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Device Status</small>
                        <h4 id="statusValue" class="mt-2 text-success">ONLINE</h4>
                    </div>
                    <i class="bi bi-wifi fs-2 text-success"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Chart Section -->
    <div class="row g-4 mb-4">

        <!-- Voltage Chart -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 shadow-sm h-100">
                <h5 class="mb-3 text-warning">
                    <i class="bi bi-lightning-charge"></i> Voltage Monitoring
                </h5>
                <canvas id="voltageChart" height="120"></canvas>
            </div>
        </div>

        <!-- Current Chart -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 shadow-sm h-100">
                <h5 class="mb-3 text-info">
                    <i class="bi bi-activity"></i> Current Monitoring
                </h5>
                <canvas id="currentChart" height="120"></canvas>
            </div>
        </div>

    </div>

    <!-- Activity Log -->
    <div class="card card-custom p-4 shadow-sm">
        <h5 class="mb-3">Recent Activity</h5>
        <table class="table table-dark table-striped table-hover">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Event</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>09:12:01</td>
                    <td>Device Connected</td>
                    <td><span class="badge bg-success">Success</span></td>
                </tr>
                <tr>
                    <td>09:15:34</td>
                    <td>Voltage Spike Detected</td>
                    <td><span class="badge bg-warning text-dark">Warning</span></td>
                </tr>
                <tr>
                    <td>09:18:20</td>
                    <td>Normal Operation</td>
                    <td><span class="badge bg-info">Info</span></td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        let intervalRealtime = null;
        let startTime = null;
        let endTimeGlobal = null;
        let currentMode = "duration";

        // ================= MODE TOGGLE =================
        document.getElementById("modeDuration").addEventListener("click", function () {

            currentMode = "duration";

            this.classList.add("active");
            document.getElementById("modeSchedule").classList.remove("active");

            document.getElementById("durationSection").style.display = "block";
            document.getElementById("scheduleSection").style.display = "none";

            calculateStandby();
        });

        document.getElementById("modeSchedule").addEventListener("click", function () {

            currentMode = "schedule";

            this.classList.add("active");
            document.getElementById("modeDuration").classList.remove("active");

            document.getElementById("durationSection").style.display = "none";
            document.getElementById("scheduleSection").style.display = "block";

            calculateStandby();
        });

        // ================= STANDBY CALCULATION =================
        document.getElementById("durationInput").addEventListener("input", calculateStandby);
        document.getElementById("startTimeInput").addEventListener("change", calculateStandby);
        document.getElementById("endTimeInput").addEventListener("change", calculateStandby);

        function calculateStandby() {

            let totalSeconds = 0;

            if (currentMode === "duration") {

                let hours = parseFloat(document.getElementById("durationInput").value);

                if (!isNaN(hours) && hours > 0) {
                    totalSeconds = Math.floor(hours * 3600);
                }

            } else {

                let startVal = document.getElementById("startTimeInput").value;
                let endVal = document.getElementById("endTimeInput").value;

                if (startVal && endVal) {

                    let start = new Date(startVal);
                    let end = new Date(endVal);

                    if (end > start) {
                        totalSeconds = Math.floor((end - start) / 1000);
                    }
                }
            }

            updateStandbyDisplay(totalSeconds);
        }

        function updateStandbyDisplay(totalSeconds) {

            const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
            const seconds = String(totalSeconds % 60).padStart(2, '0');

            document.getElementById("standbyTotal").innerText =
                `${hours}:${minutes}:${seconds}`;
        }

        // ================= CHART CONFIG =================
        const commonOptions = (yLabelText) => ({
            responsive: true,
            animation: false,
            plugins: { legend: { display: false } },
            scales: {
                x: {
                    title: { display: true, text: 'Time', color: 'white' },
                    ticks: { color: 'white' }
                },
                y: {
                    title: { display: true, text: yLabelText, color: 'white' },
                    ticks: { color: 'white' }
                }
            }
        });

        const voltageChart = new Chart(document.getElementById('voltageChart'), {
            type: 'line',
            data: { labels: [], datasets: [{ data: [], tension: 0.4 }] },
            options: commonOptions("Voltage (Volt)")
        });

        const currentChart = new Chart(document.getElementById('currentChart'), {
            type: 'line',
            data: { labels: [], datasets: [{ data: [], tension: 0.4 }] },
            options: commonOptions("Current (Ampere)")
        });

        // ================= DUMMY REALTIME =================
        function generateDummyData() {
            return {
                voltage: (218 + Math.random() * 6).toFixed(2),
                current: (1.2 + Math.random() * 0.2).toFixed(2)
            };
        }

        function updateRealtime() {

            const data = generateDummyData();
            const now = new Date().toLocaleTimeString();

            document.getElementById("voltageValue").innerText = data.voltage + " V";
            document.getElementById("currentValue").innerText = data.current + " A";

            voltageChart.data.labels.push(now);
            voltageChart.data.datasets[0].data.push(data.voltage);

            if (voltageChart.data.labels.length > 15) {
                voltageChart.data.labels.shift();
                voltageChart.data.datasets[0].data.shift();
            }

            voltageChart.update();

            currentChart.data.labels.push(now);
            currentChart.data.datasets[0].data.push(data.current);

            if (currentChart.data.labels.length > 15) {
                currentChart.data.labels.shift();
                currentChart.data.datasets[0].data.shift();
            }

            currentChart.update();
        }

        // ================= TIMER =================
        function scheduleChecker() {

            let now = new Date();

            if (now >= startTime && now < endTimeGlobal) {

                document.getElementById("statusValue").innerText = "RUNNING";
                document.getElementById("statusValue").className = "mt-2 text-success";

                updateRealtime();
                updateLifetime();

            } else if (now >= endTimeGlobal) {

                document.getElementById("statusValue").innerText = "COMPLETED";
                document.getElementById("statusValue").className = "mt-2 text-primary";

                clearInterval(intervalRealtime);

                document.getElementById("startBtn").disabled = false;
                document.getElementById("stopBtn").disabled = true;
            }
        }

        function updateLifetime() {

            const now = new Date();
            const diff = Math.floor((now - startTime) / 1000);

            const hours = String(Math.floor(diff / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
            const seconds = String(diff % 60).padStart(2, '0');

            document.getElementById("lifetimeValue").innerText =
                `${hours}:${minutes}:${seconds}`;
        }

        // ================= START =================
        document.getElementById("startBtn").addEventListener("click", function () {

            if (currentMode === "duration") {

                let hours = parseFloat(document.getElementById("durationInput").value);

                if (isNaN(hours) || hours <= 0) {
                    alert("Invalid duration value");
                    return;
                }

                let totalSeconds = Math.floor(hours * 3600);

                startTime = new Date();
                endTimeGlobal = new Date(startTime.getTime() + totalSeconds * 1000);

            } else {

                let startVal = document.getElementById("startTimeInput").value;
                let endVal = document.getElementById("endTimeInput").value;

                if (!startVal || !endVal) {
                    alert("Invalid schedule time");
                    return;
                }

                startTime = new Date(startVal);
                endTimeGlobal = new Date(endVal);

                if (endTimeGlobal <= startTime) {
                    alert("End time must be greater than start time");
                    return;
                }
            }

            intervalRealtime = setInterval(scheduleChecker, 1000);

            this.disabled = true;
            document.getElementById("stopBtn").disabled = false;
        });

        // ================= STOP =================
        document.getElementById("stopBtn").addEventListener("click", function () {

            clearInterval(intervalRealtime);

            document.getElementById("statusValue").innerText = "STOPPED";
            document.getElementById("statusValue").className = "mt-2 text-danger";

            this.disabled = true;
            document.getElementById("startBtn").disabled = false;
        });
    </script>
}