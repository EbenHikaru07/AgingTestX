@using AgingTest.Models.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<DashboardViewModel>

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var total = Model.Count;
    var online = Model.Count(x => x.OperationalStatus == "READY");
    var running = Model.Count(x => x.OperationalStatus == "RUNNING");
    var down = Model.Count(x => x.OperationalStatus == "DOWNTIME");
}

<style>
    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
    }

    .status-online {
        background: #22c55e;
    }

    .status-offline {
        background: #9ca3af;
    }

    .status-downtime {
        background: #ef4444;
    }
</style>
<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-semibold mb-1">Aging Test Dashboard</h3>
            <small class="text-muted">Realtime monitoring device aging process</small>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <small class="text-muted">Total Device</small>
                <h2 class="fw-bold mb-0">@total</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-success text-white">
                <small>Ready Device</small>
                <h2 class="fw-bold mb-0">@online</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-primary text-white">
                <small>Running Device</small>
                <h2 class="fw-bold mb-0">@running</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-danger text-white">
                <small>Downtime Device</small>
                <h2 class="fw-bold mb-0">@down</h2>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dashboardTable" class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Device</th>
                            <th>IoT Module</th>
                            <th>Operational Status</th>
                            <th width="350">Aging Progress</th>
                            <th>Last Finished</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">
                                        @item.nama_device
                                    </div>

                                    <small class="text-muted">
                                        @item.kode_device
                                    </small>
                                </td>
                                <td>

                                    <div class="d-flex align-items-center">

                                        <span class="status-dot
                @(item.ModuleStatus == "ONLINE"
                                                              ? "status-online"
                                                              : item.ModuleStatus == "OFFLINE"
                                                                  ? "status-offline"
                                                                  : "status-downtime")">
                                    </span>

                                        <div>

                                            <div class="fw-semibold">
                                                @item.ModuleName
                                            </div>

                                            <small class="text-muted">
                                                Last beat :
                                                @(item.LastHeartbeat?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")
                                            </small>

                                        </div>

                                    </div>

                                </td>
                                <td>

                                @if (item.OperationalStatus == "RUNNING")
                                    {
                                        <span class="badge bg-primary rounded-0 px-3 py-2">
                                            RUNNING
                                        </span>
                                    }

                                    else if (item.OperationalStatus == "READY")
                                    {
                                        <span class="badge bg-success rounded-0 px-3 py-2">
                                            READY
                                        </span>
                                    }

                                    else if (item.OperationalStatus == "FINISHED")
                                    {
                                        <span class="badge bg-info rounded-0 px-3 py-2">
                                            READY
                                        </span>
                                    }

                                    else if (item.OperationalStatus == "MODULE OFF")
                                    {
                                        <a asp-action="IoTDeviceData"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-warning btn-sm rounded-0">

                                            MODULE OFF

                                        </a>
                                    }

                                    else if (item.OperationalStatus == "DEVICE OFF")
                                    {
                                        <a asp-action="DeviceAging"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-secondary btn-sm rounded-0">

                                            DEVICE OFF

                                        </a>
                                    }

                                    else if (item.OperationalStatus == "DOWNTIME")
                                    {
                                        <a asp-action="DeviceAging"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-danger btn-sm rounded-0">

                                            DOWNTIME

                                        </a>
                                    }

                                    else if (item.OperationalStatus == "NO MODULE")
                                    {
                                        <a asp-action="DeviceAging"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-dark btn-sm rounded-0">

                                            NO MODULE

                                        </a>
                                    }

                                </td>
                                <td style="min-width:220px">

                                    @if (item.IsRunning)
                                    {

                                        <div class="small text-muted mb-1">

                                            @(item.StartTime?.ToString("dd MMM HH:mm"))
                                            -
                                            @(item.EndTime?.ToString("dd MMM HH:mm"))

                                        </div>

                                        <div class="progress rounded-pill"
                                             style="height:10px">

                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                                 style="width:@(item.ProgressPercent)%">
                                            </div>

                                        </div>

                                        <div class="small text-end fw-semibold mt-1">
                                            @item.ProgressPercent %
                                        </div>

                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>
                                <td>

                                    @if (item.LastFinishedTime != null)
                                    {
                                        <div>
                                            @item.LastFinishedTime?.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @item.LastFinishedTime?.ToString("HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Never Run
                                        </span>
                                    }

                                </td>
                                <td>
                                    @if (item.IsRunning)
                                    {
                                        <a asp-action="MonitoringAging"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-outline-primary btn-sm">

                                            Monitor

                                        </a>
                                    }
                                    else if (item.CanStartAging)
                                    {
                                        <a asp-action="SetUpAging"
                                           asp-route-deviceId="@item.id_device"
                                           class="btn btn-outline-success btn-sm">
                                            Start Aging
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm"
                                                disabled>

                                            -

                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#dashboardTable').DataTable({
            responsive:true,
            pageLength:10,
            language:{
                search:"",
                searchPlaceholder:"Search device..."
            }
        });
    </script>
}