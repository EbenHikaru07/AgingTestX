    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model List<AgingTest.Models.IoTModuleModel>

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "IoT Device Data";
}

<div class="container">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-semibold mb-1">IoT Module Management</h3>
            <p class="text-muted mb-0">
                Monitoring and management for registered IoT modules
            </p>
        </div>
        <button class="btn btn-primary px-4 rounded-3 shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#modalEntry">
            <i class="fa-solid fa-plus me-2"></i>
            Add Module
        </button>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-2 shadow-sm rounded-0">
        <div class="card-body">
            <div class="table-responsive">

                @if (Model != null && Model.Any())
                {
                    <table id="iotTable" class="table align-middle table-hover w-100">

                        <thead class="table-light">
                            <tr>
                                <th>No</th>
                                <th>Module Name</th>
                                <th>MAC Address</th>
                                <th>Device Name</th>
                                <th>Status Module</th>
                                <th>Last Heartbeat</th>
                                <th width="140">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int no = 1;
                            }

                            @foreach (var item in Model)
                            {
                                var isOnline =
                                item.last_heartbeat != null &&
                                (DateTime.Now - item.last_heartbeat.Value).TotalSeconds < 30;

                                <tr>

                                    <td>@no</td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.module_name
                                        </div>
                                    </td>

                                    <td>
                                        @item.mac_address
                                    </td>

                                    <td>
                                        @(item.AgingDevices?.FirstOrDefault()?.device_name ?? "Not Used")
                                    </td>

                                    <td>

                                        @if (isOnline)
                                        {
                                            <span class="badge bg-success">
                                                Online
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Offline
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(item.last_heartbeat?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <button class="btn btn-warning btn-sm">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <button class="btn btn-danger btn-sm">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                no++;
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        No IoT module data available
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalEntry">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-2 rounded-0 shadow">
            <form asp-action="IoTDeviceEntry" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-semibold">
                        Add IoT Module
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-3">
                    <div class="mb-3">
                        <label class="form-label">
                            Module Name
                        </label>
                        <input name="module_name"
                               class="form-control rounded-3"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            MAC Address
                        </label>
                        <input name="mac_address" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            IP Address
                        </label>
                        <input name="ip_address" class="form-control rounded-3" />
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal"> Cancel </button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"> Save </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
              $(document).ready(function () {

            if ($('#iotTable').length) {

                $('#iotTable').DataTable({

                    responsive: true,
                    autoWidth: false,

                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    language: {

                        search: "",

                        searchPlaceholder: "Search module...",

                        lengthMenu: "Show _MENU_ entries",

                        info: "Showing _START_ to _END_ of _TOTAL_ modules",

                        emptyTable: "No module data available",

                        zeroRecords: "No matching module found",

                        paginate: {
                            previous: "<",
                            next: ">"
                        }
                    }
                });

            }

        });
    </script>
}