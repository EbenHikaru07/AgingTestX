    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
    ViewData["Title"] = "Login - IoT Aging Test Monitoring";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="@Url.Content("~/lib/fontawesome/css/all.min.css")" />

    <style>
        body {
            height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            border-radius: 0px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
        }

        .form-control {
            background: rgba(255,255,255,0.1);
            border: none;
            border-radius: 0px;
            color: white;
        }

            .form-control:focus {
                background: rgba(255,255,255,0.15);
                border-radius: 0px;
                box-shadow: none;
                color: white;
                border: 1px solid #2563eb;
            }

        .btn-login {
            background: linear-gradient(45deg, #64A70B, #55A2CA);
            border-radius: 0px;
            border: none;
            color: white;
        }

            .btn-login:hover {
                opacity: 0.8;
            }

        .btn-back {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 0px;
            color: white;
        }

            .btn-back:hover {
                background: rgba(255,255,255,0.1);
            }

        .brand-title {
            font-weight: 600;
            letter-spacing: 1px;
        }

        .linkedin-link {
            color: #0A66C2;
            font-size: 18px;
            margin-left: 5px;
        }

            .linkedin-link:hover {
                opacity: 0.8;
            }
    </style>
</head>
<body>

    <div class="login-card shadow-lg">
        <div class="text-center mb-4">
            <img src="~/images/logo.png" style="height:60px;" />
            <div class="brand-title mt-3">Aging X Access Panel</div>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-circle-exclamation me-2"></i>
                @ViewBag.Error
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }
        <form asp-controller="Auth" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Badge</label>
                <input name="badge" class="form-control" required autocomplete="off" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-login w-100 mb-3">
                Masuk
            </button>

            <a asp-controller="Home" asp-action="LandingPage" class="btn btn-back w-100">
                <i class="fa fa-home"></i> Home
            </a>
        </form>

        <div class="text-center mt-4 small opacity-75">
            © @DateTime.Now.Year Aging X | v1.0.0
            <a href="https://www.linkedin.com" target="_blank" class="linkedin-link">
                <i class="fab fa-linkedin"></i>
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
