@{
    var title = ViewData["Title"] ?? "IoT Aging Test Monitoring System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/lib/fontawesome/css/all.min.css")" />

    <style>
        body {
            scroll-behavior: smooth;
        }

        .navbar {
            background: #25343F;
            backdrop-filter: blur(8px);
        }

        .navbar-brand {
            font-weight: 600;
            letter-spacing: 1px;
        }

        footer {
            background: #0f172a;
        }

            footer p {
                margin: 0;
            }

        .btn-primary {
            background: linear-gradient(45deg, #2563eb, #1d4ed8);
            border: none;
        }

            .btn-primary:hover {
                opacity: 0.9;
            }

        .navbar-brand img {
            transition: 0.3s;
        }

        .navbar-brand:hover img {
            transform: scale(1.05);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Hreff" target="_blank">
                <img src="~/images/logo.png"
                     alt="Aging Logo"
                     
                     class="me-2"
                     style="height:45px; width:auto;" />
                @* <div class="d-flex flex-column lh-1">
                    <span class="fw-bold">eGingMon</span>
                </div> *@
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        @* <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                            Login
                        </a> *@
                        @* <a class="btn btn-primary">
                            Login
                        </a> *@
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-3 mt-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">

                <div class="small text-light opacity-75">
                    © @DateTime.Now.Year Aging X. All Rights Reserved.
                </div>
                <div class="small">
                    IoT Aging Test Monitoring System |
                    <a href="https://www.linkedin.com/in/eben-ezer-hikaru-hutabarat/"
                       target="_blank"
                       class="text-info text-decoration-none">
                        Who Build This Website?
                    </a>
                </div>

            </div>
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
